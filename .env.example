# Speech services
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# OpenAI-compatible LLM
# Defaults live in config.example.json and local config.json.
# These env vars are deployment overrides.
# LOCAL_VOICE_TESTING=true uses the local Hermes URL from config.
# LOCAL_VOICE_TESTING=false uses the Cloudflare URL from config.
# OPENAI_API_KEY is optional for local gateways that do not enforce auth
OPENAI_API_KEY=
OPENAI_MODEL=hermes-model
LOCAL_VOICE_TESTING=true

# Local audio device overrides.
# Leave device indexes empty to use the OS default devices. When an
# echo-cancelled PipeWire/Pulse source is configured, set
# LOCAL_AUDIO_BARGE_IN=true to allow user interruption while the bot speaks.
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=
LOCAL_AUDIO_BARGE_IN=false

# Wake listener runtime
# local: run the full Pipecat bot on this device
# remote_daily: run only a Daily/Pipecat client and connect to deployed bot
VOICE_RUNTIME_MODE=local

# Remote Daily/Pipecat client.
# EIGI_API_KEY is secret and must stay in .env.
# Non-secret defaults live in config.example.json/local config.json;
# per-device settings live in user.json.
EIGI_API_KEY=
USER_CONFIG_FILE=user.json
VOICE_CLIENT_TYPE=native
VOICE_CLIENT_HOST=127.0.0.1
VOICE_CLIENT_PORT=8090
VOICE_CLIENT_NATIVE_BIN=
VOICE_CLIENT_NATIVE_CONFIG_FILE=

# Local setup dashboard
# Defaults live in config.example.json/local config.json;
# use these only for deployment overrides.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_DEBUG=false
DASHBOARD_DEFAULT_USERNAME=admin
DASHBOARD_SESSION_TTL_HOURS=12
