{
  "hermes": {
    "gateway_command": "hermes gateway run --replace",
    "host": "127.0.0.1",
    "port": 8642
  },
  "voice_bot": {
    "local_voice_testing": true,
    "local_openai_base_url": "http://{host}:{port}/v1",
    "cloudflare_openai_base_url": "https://your-cloudflare-tunnel.trycloudflare.com/v1",
    "openai_model": "hermes-model",
    "cartesia_voice_id": ""
  },
  "cloudflare": {
    "bin": "cloudflared",
    "wait_timeout_secs": 90,
    "quick_tunnel": "true",
    "target_url": "http://localhost:{port}"
  },
  "runtime": {
    "voice_runtime_mode": "local",
    "pid_file": "run/bot.pid",
    "user_config_file": "user.json"
  },
  "wake_word": {
    "model": "hey jarvis",
    "threshold": 0.5,
    "cooldown_secs": 8.0,
    "vad_threshold": 0.5,
    "inference_framework": "onnx"
  },
  "audio": {
    "sample_rate": 16000,
    "chunk_size": 1280,
    "input_device_index": null,
    "output_device_index": null,
    "local_audio_barge_in": false
  },
  "dashboard": {
    "host": "0.0.0.0",
    "port": 8080,
    "debug": false,
    "default_username": "admin",
    "session_ttl_hours": 12,
    "auth_file": "run/dashboard_auth.json",
    "static_dir": "dashboard/static"
  },
  "remote_voice": {
    "public_api_base_url": "http://localhost:4000/v1/public",
    "daily_session_url": "http://localhost:4000/v1/public/daily",
    "agent_id": "",
    "conversation_metadata": {},
    "dynamic_variables": {},
    "conversation_visibility": false,
    "conversation_config_type": "VOICE",
    "is_test_call": false
  },
  "voice_client": {
    "type": "native",
    "host": "127.0.0.1",
    "port": 8090,
    "native_bin": "voice_client/native_daily/bin/pipecat-daily-client",
    "native_config_file": "voice_client/native_daily/config.json"
  }
}
