[Unit]
Description=Hermes gateway for Raspberry Pi voice bot
After=network-online.target
Wants=network-online.target
PartOf=voice-assistant-stack.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
ExecStart=__PROJECT_ROOT__/scripts/start_hermes_gateway.sh
Restart=always
RestartSec=5
TimeoutStopSec=210

[Install]
WantedBy=multi-user.target
WantedBy=voice-assistant-stack.target
