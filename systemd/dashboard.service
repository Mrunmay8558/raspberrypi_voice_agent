[Unit]
Description=Local Raspberry Pi voice dashboard
After=network-online.target
Wants=network-online.target
PartOf=voice-assistant-stack.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
ExecStart=__PROJECT_ROOT__/.venv/bin/python -m dashboard.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
WantedBy=voice-assistant-stack.target
